# Fixed admin password for local debugging
# Copy this file to .env and enter your desired fixed password. Do not use or modify this example file directly.
# The .env file is ignored by Git and will not be committed to the repository.
# Note: The extraction script reads all characters after the equals sign verbatim (do not add quotes unless you want them included in the password).
ALIST_ADMIN_PASSWORD=your_fixed_password_here